# e2e sur backend local (docker-compose à la racine du repo).
# Émulateur Android : 10.0.2.2 = localhost de l'hôte (cleartext autorisé par network_security_config).
# À charger avec `npx dotenv-cli --override -e .env.e2e-local` pour surclasser le .env.local de direnv.
APP_OA_FILES_URL=http://10.0.2.2:4292/api/v1/oas
APP_MINIO_URL=http://10.0.2.2:4290
APP_GRAPHQL_URL=http://10.0.2.2:4201/v1/graphql
APP_GRAPHQL_WS_URL=ws://10.0.2.2:4201/v1/graphql
APP_GEOLOC_SYNC_URL=http://10.0.2.2:4200/api/v1/oas/geoloc/sync

STAGING_APP_OA_FILES_URL=
STAGING_APP_MINIO_URL=
STAGING_APP_GRAPHQL_URL=
STAGING_APP_GRAPHQL_WS_URL=
STAGING_APP_GEOLOC_SYNC_URL=

APP_OSRM_CAR_URL=http://10.0.2.2:4261
APP_OSRM_FOOT_URL=http://10.0.2.2:4262
APP_OSRM_BICYCLE_URL=http://10.0.2.2:4263
APP_MAPVIEW_STYLE_URL=http://10.0.2.2:4203/app/style.json
APP_MAPVIEW_DARK_STYLE_URL=http://10.0.2.2:4203/app/dark-matter/style.json
CLAIMS_NAMESPACE=https://alertesecours.fr/claims

LOCAL_DEV=true
SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
SENTRY_ALLOW_FAILURE=true
