# Sentry configuration
SENTRY_URL=https://glitchtip.devthefuture.org
SENTRY_DSN=your_glitchtip_dsn_here
SENTRY_ORG=alerte-secours

SENTRY_PROJECT=app
SENTRY_DISABLE_AUTO_UPLOAD=true
LOCAL_DEV=true

# Android Emulator Configuration
ANDROID_EMULATOR_NAME=Pixel_6_API_30

ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=
PROVIDER_ID=

# Background Geolocation License Keys
BACKGROUND_GEOLOCATION_LICENSE_ANDROID=your_license_key_here
BACKGROUND_GEOLOCATION_LICENSE_IOS=your_license_key_here